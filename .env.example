# Copy to `.env.local` to run the site against a local Supabase stack (`npm run db:start`).
#
# Both values are public by design: they ship in the browser bundle, and row level security is what
# protects the data. Take them from `supabase status` (API URL and anon key). Never put the
# service-role key here — it bypasses RLS, and only the webhook and batch jobs may use it, server-side.
#
# Unset is a supported state: the auth pages render an explanation and the proxy returns early, so
# the drills work exactly as before.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54351
NEXT_PUBLIC_SUPABASE_ANON_KEY=
