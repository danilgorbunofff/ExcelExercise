{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 4180",
      "startServerReadyPattern": "Local:\\s+http",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:4180/",
        "http://127.0.0.1:4180/pricing",
        "http://127.0.0.1:4180/learn/excel/sum-basics",
        "http://127.0.0.1:4180/excel-functions/countif",
        "http://127.0.0.1:4180/learn"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["canonical", "is-crawlable", "robots-txt", "hreflang"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports"
    }
  }
}
