  "sentence": {
    "maxWords": 30,
    "maxMeanWords": 22,
    "why": "a lesson sentence that needs a second read to parse is a sentence that gets skipped"
  },

  "paragraph": {
    "maxWords": 130,
    "why": "the docs column is about 60 characters wide; past 130 words the reader loses the thread"
  },

  "flesch": {
    "min": 50,
    "max": 88,
    "why": "below 50 the prose is academic, above 88 it is so simple it says nothing. Adult technical writing lands in the 50s and 60s"
  },

  "seoTitle": {
    "minChars": 18,
    "maxChars": 60,
    "why": "Google truncates around 60 characters; shorter than 18 says nothing the URL does not already say"
  },

  "seoDescription": {
    "minChars": 70,
    "maxChars": 155,
    "why": "70 to 155 characters is what a search result shows before it truncates"
  },

  "shingle": {
    "size": 5,
    "maxOverlap": 0.3,
    "why": "two lessons that share a third of their five-word runs read as one page duplicated, and Google treats them that way"
