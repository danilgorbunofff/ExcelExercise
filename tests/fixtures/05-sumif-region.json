{
  "accepted": [
    "=SUMIF(A2:A6,\"North\",B2:B6)",
    "=sumif($A$2:$A$6,\"north\",$B$2:$B$6)",
    "=SUMIF(A2:A6,\"N*\",B2:B6)",
    "=SUMIF(A2:A6,\"North\",B2)",
    "=SUMIF(A2:A6,\"North\",B2:B6)+0",
    "=SUMIF(A2:A6,\"North\",B2:B6)/1"
  ],
  "rejected": [
    {
      "formula": "=SUMIF(A2:A6,\"North\")",
      "rule": "func-sumif",
      "why": "no sum range, so SUMIF sums the region names"
    },
    {
      "formula": "=SUMIF(B2:B6,\"North\",A2:A6)",
      "rule": "value",
      "why": "the ranges are swapped, so it sums the text column"
    },
    {
      "formula": "=SUMIF(A2:A6,\"South\",B2:B6)",
      "rule": "value",
      "why": "South total, 250, instead of North's 900"
    },
    {
      "formula": "=SUMIF(A2:A5,\"North\",B2:B5)",
      "rule": "value",
      "why": "stops before the last North row"
    },
    {
      "formula": "=SUM(B2:B6)",
      "rule": "func-sumif",
      "why": "adds every region instead of filtering"
    },
    {
      "formula": "=SUMIF(A3:A6,\"North\",B3:B6)",
      "rule": "require-ref",
      "why": "the region column starts at A3, so A2 is never read and the first North row is skipped"
    },
    {
      "formula": "=SUMIF(A2:A6,\"North\",C2:C6)",
      "rule": "require-ref",
      "why": "sums the empty column instead of B2:B6"
    },
    {
      "formula": "=SUMIF(A2:A6,\"North\",B2:B6)/0",
      "rule": "error",
      "why": "divides the total by zero"
    },
    {
      "formula": "=SUMIF(A2:A6,\"North\",B2:B6",
      "rule": "syntax",
      "why": "unclosed bracket"
    }
  ]
}
