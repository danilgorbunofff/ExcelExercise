{
  "accepted": [
    "=VLOOKUP(D2,A2:C6,3,FALSE)",
    "=vlookup(d2,a2:c6,3,false)",
    "=VLOOKUP(D2,A2:C6,3,0)",
    "=VLOOKUP($D$2,$A$2:$C$6,3,FALSE)",
    "=VLOOKUP(D2,A2:C6,3,FALSE)+0",
    "=VLOOKUP(D2,$A$2:$C$6,3,0)*1"
  ],
  "rejected": [
    {
      "formula": "=VLOOKUP(D2,A2:C6,3)",
      "rule": "exact-match",
      "why": "no fourth argument, so Excel defaults to approximate"
    },
    {
      "formula": "=VLOOKUP(D2,A2:C6,3,TRUE)",
      "rule": "exact-match",
      "why": "approximate match"
    },
    {
      "formula": "=VLOOKUP(D2,A2:C6,3,1)",
      "rule": "exact-match",
      "why": "1 means approximate too"
    },
    {
      "formula": "=VLOOKUP(D2,A2:C6,2,FALSE)",
      "rule": "value",
      "why": "returns the name column, not the salary"
    },
    {
      "formula": "=VLOOKUP(\"E-103\",A2:C6,3,FALSE)",
      "rule": "value",
      "why": "the right lookup, the wrong employee"
    },
    {
      "formula": "=INDEX(C2:C6,4)",
      "rule": "func-vlookup",
      "why": "INDEX is the next lesson"
    },
    {
      "formula": "=VLOOKUP(\"E-104\",B2:C6,2,FALSE)",
      "rule": "require-ref",
      "why": "the table starts at B, so the ID column is gone"
    },
    {
      "formula": "=VLOOKUP(D2,A2:C6,4,FALSE)",
      "rule": "error",
      "why": "#REF! — column 4 of a three-column table"
    },
    {
      "formula": "=54000",
      "rule": "func-vlookup",
      "why": "the salary is typed, not looked up"
    },
    {
      "formula": "=VLOOKUP(D2,A2:C6,3,FALSE",
      "rule": "syntax",
      "why": "unclosed bracket"
    }
  ]
}
