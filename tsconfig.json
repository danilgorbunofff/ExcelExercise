{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib/**/*.js", "app/**/*.js", "proxy.js", "instrumentation.js"],
  "exclude": ["node_modules"]
}
